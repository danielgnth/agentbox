#!/bin/bash
# agentbox — reproducible Claude Code sandboxes on Docker Sandboxes (sbx).
#
#   agentbox setup                       one-time host setup (idempotent)
#   agentbox doctor                      check host setup and validate kits
#   agentbox up <[owner/]repo> [opts]    create sandbox, scope token, clone, open VS Code
#        --name <n>   sandbox name (default: repo name)
#        --cloud      add the cloud-tools mixin (gcloud, kubectl, ...)
#        --kit <k>    add another mixin (dir under kits/ or a kit reference)
#        --no-code    don't open VS Code afterwards
#   agentbox code <name>                 open VS Code (Remote-SSH) in the repo
#   agentbox shell <name>                bash in the repo
#   agentbox claude <name>               Claude Code TUI in the repo
#   agentbox creds <name>                drop 1h read-only gcloud/kubectl tokens in
#   agentbox protect <[owner/]repo>      CI attribution check + ruleset + App access
#   agentbox rm <name> [--force]         remove sandbox (refuses if work is unpushed)
#   agentbox ls                          list sandboxes
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# shellcheck source=SCRIPTDIR/../config.env
. "$ROOT/config.env"
export SBX_NO_TELEMETRY=1

WORKSPACE=/home/agent/workspace

die()  { echo "agentbox: $*" >&2; exit 1; }
info() { printf '\033[1m==> %s\033[0m\n' "$*" >&2; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found${2:+ ($2)}"; }

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# "owner/repo" or "repo" -> sets OWNER and REPO
parse_repo() {
  case "$1" in
    */*) OWNER=${1%%/*}; REPO=${1#*/} ;;
    *)   OWNER=$GH_DEFAULT_OWNER; REPO=$1 ;;
  esac
  REPO=${REPO%.git}
  [[ $OWNER =~ ^[A-Za-z0-9-]+$ && $REPO =~ ^[A-Za-z0-9._-]+$ ]] || die "bad repo: $1"
}

# Sandbox name from a repo name: lowercase, [a-z0-9-], max 63 chars.
default_name() {
  local n
  n=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//')
  printf '%s' "${n:0:63}"
}

valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "bad sandbox name: $1"; }

# Claude Code's project folder name for a working directory.
claude_slug() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

# Co-author line: config value, or derived from your own gh login.
resolve_coauthor() {
  if [ -n "$COAUTHOR" ]; then printf '%s' "$COAUTHOR"; return; fi
  need gh "needed to derive COAUTHOR; or set it in config.env"
  gh api user --jq '"\(.name // .login) <\(.id)+\(.login)@users.noreply.github.com>"' \
    || die "could not derive COAUTHOR from 'gh api user' (set it in config.env)"
}

kit_ref() { # local kit dir name -> absolute path; anything else passes through
  if [ -d "$ROOT/kits/$1" ]; then printf '%s' "$ROOT/kits/$1"; else printf '%s' "$1"; fi
}

repo_dir() { printf '%s/%s' "$WORKSPACE" "$1"; }

# ---------------------------------------------------------------------------

cmd_setup() {
  need sbx "brew install docker/tap/sbx"
  need op "brew install 1password-cli"

  info "Hardening sbx (no SSH agent forwarding)"
  sbx settings set ssh.agentForwardingEnabled false
  sbx daemon restart

  info "Enabling SSH access to sandboxes (<name>.sbx)"
  sbx setup ssh

  if security find-generic-password -a "$USER" -s "$OP_KEYCHAIN_SERVICE" >/dev/null 2>&1; then
    info "Keychain item '$OP_KEYCHAIN_SERVICE' exists"
  else
    info "Storing the 1Password service account token in the Keychain"
    local ref
    read -r -p "op:// reference of the service account token: " ref
    [ -n "$ref" ] || die "no reference given"
    security add-generic-password -U -a "$USER" -s "$OP_KEYCHAIN_SERVICE" -w "$(op read "$ref")"
  fi
  [ "$("$ROOT/bin/op-agents" vault list --format json | jq -r 'length')" = 1 ] \
    || warn "service account sees more than one vault; scope it to '$OP_VAULT' only"

  cat >&2 <<EOF

Add to your shell profile:
  export PATH="$ROOT/bin:\$PATH"
  export SBX_NO_TELEMETRY=1

Add to VS Code user settings (installs these into every new sandbox):
  "remote.SSH.defaultExtensions": ["anthropic.claude-code"]
EOF
}

cmd_doctor() {
  local ok=1 k
  check() { if "$@" >/dev/null 2>&1; then echo "  ok    $label"; else echo "  FAIL  $label"; ok=0; fi; }
  info "Host"
  label="sbx installed";            check command -v sbx
  label="op installed";             check command -v op
  label="jq installed";             check command -v jq
  label="code CLI installed";       check command -v code
  label="gh installed (optional)";  check command -v gh
  label="Keychain token present";   check security find-generic-password -a "$USER" -s "$OP_KEYCHAIN_SERVICE"
  label="op-agents authenticates";  check "$ROOT/bin/op-agents" whoami
  label="App key readable";         check "$ROOT/bin/op-agents" document get "$GH_APP_KEY_DOC" --vault "$OP_VAULT"
  label="sbx SSH config present";   check grep -rqs '\.sbx' "$HOME/.ssh/config" "$HOME/.ssh/config.d"
  sbx version 2>/dev/null | sed 's/^/  /' || true

  info "Kits (sbx kit inspect builds each one; the first run is slow)"
  for k in "$ROOT"/kits/*/; do
    k=${k%/}
    label="kit $(basename "$k")"; check sbx kit inspect "$k"
  done
  [ "$ok" = 1 ] || die "some checks failed (re-run the failing command by hand to see why)"
}

cmd_up() {
  [ $# -ge 1 ] || usage 1
  parse_repo "$1"; shift
  local name="" open_code=1 kits=$DEFAULT_KITS
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)    name=${2:?}; shift 2 ;;
      --cloud)   kits="$kits $CLOUD_KITS"; shift ;;
      --kit)     kits="$kits ${2:?}"; shift 2 ;;
      --no-code) open_code=0; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  name=${name:-$(default_name "$REPO")}
  valid_name "$name"
  need sbx

  local coauthor session_dir="" args_file
  coauthor=$(resolve_coauthor)
  if [ "$SESSION_MIRROR" = 1 ]; then
    session_dir="$HOME/.claude/projects/$(claude_slug "$(repo_dir "$name")")"
    mkdir -p "$session_dir"
  fi

  args_file=$(mktemp)
  trap 'rm -f "$args_file"' RETURN
  {
    echo "agent-config.project=$name"
    echo "agent-config.bot_name=$GH_BOT_NAME"
    echo "agent-config.bot_email=$GH_BOT_EMAIL"
    echo "agent-config.coauthor=$coauthor"
    echo "agent-config.session_dir=$session_dir"
    echo "agent-config.git_ai=$GIT_AI"
  } > "$args_file"

  local create=(sbx create --name "$name" "$WORKLOAD" --kit-args-file "$args_file") k
  for k in $kits; do create+=(--kit "$(kit_ref "$k")"); done
  [ -z "$session_dir" ] || create+=("$session_dir")

  info "Creating sandbox '$name' ($kits)"
  "${create[@]}"

  info "Scoping a 1h GitHub App token to $OWNER/$REPO"
  sbx secret set github --sandbox "$name" \
    --command "$ROOT/bin/gh-agent-token $REPO" --refresh 50m

  info "Cloning $OWNER/$REPO into $(repo_dir "$name")"
  sbx exec -e "URL=https://github.com/$OWNER/$REPO.git" -e "DEST=$(repo_dir "$name")" "$name" \
    bash -c 'set -e; [ -d "$DEST/.git" ] || git clone "$URL" "$DEST"'

  [ "$open_code" = 0 ] || cmd_code "$name"
  info "Done. Shell: agentbox shell $name   Claude: agentbox claude $name"
}

cmd_code() {
  [ $# -eq 1 ] || usage 1
  valid_name "$1"; need code "VS Code: Command Palette > Shell Command: Install 'code'"
  code --remote "ssh-remote+$1.sbx" "$(repo_dir "$1")"
}

cmd_shell() {
  [ $# -eq 1 ] || usage 1
  valid_name "$1"
  sbx exec -it -e "DEST=$(repo_dir "$1")" "$1" bash -lc 'cd "$DEST" 2>/dev/null || cd; exec bash -l'
}

cmd_claude() {
  [ $# -eq 1 ] || usage 1
  valid_name "$1"
  sbx exec -it -e "DEST=$(repo_dir "$1")" "$1" bash -lc 'cd "$DEST" && exec claude'
}

cmd_creds() {
  [ $# -eq 1 ] || usage 1
  local name=$1 did=0
  valid_name "$name"

  if [ -n "$GCP_AGENT_SA" ]; then
    need gcloud
    info "gcloud: 1h token for $GCP_AGENT_SA"
    gcloud auth print-access-token --impersonate-service-account="$GCP_AGENT_SA" 2>/dev/null \
      | sbx exec -i "$name" sh -c '
          set -e; umask 077; mkdir -p "$HOME/.config/agentbox"
          cat > "$HOME/.config/agentbox/gcloud-token"
          gcloud config set auth/access_token_file "$HOME/.config/agentbox/gcloud-token" >/dev/null 2>&1'
    did=1
  fi

  if [ -n "$KUBE_CONTEXT" ]; then
    need kubectl
    info "kubectl: 1h token for $KUBE_SA_NAMESPACE/$KUBE_SA_NAME on $KUBE_CONTEXT"
    local server ca token
    server=$(kubectl config view --minify --raw --context "$KUBE_CONTEXT" -o jsonpath='{.clusters[0].cluster.server}')
    ca=$(kubectl config view --minify --raw --context "$KUBE_CONTEXT" -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
    token=$(kubectl --context "$KUBE_CONTEXT" -n "$KUBE_SA_NAMESPACE" create token "$KUBE_SA_NAME" --duration=1h)
    printf '%s\n' \
      "apiVersion: v1" "kind: Config" \
      "clusters:" "- name: agent" "  cluster:" "    server: $server" "    certificate-authority-data: $ca" \
      "users:" "- name: agent-ro" "  user:" "    token: $token" \
      "contexts:" "- name: agent" "  context:" "    cluster: agent" "    user: agent-ro" \
      "current-context: agent" \
      | sbx exec -i "$name" sh -c 'set -e; umask 077; mkdir -p "$HOME/.kube"; cat > "$HOME/.kube/config"'
    did=1
  fi

  [ "$did" = 1 ] || die "set GCP_AGENT_SA and/or KUBE_CONTEXT in config.env"
  info "Tokens expire in one hour; run this again when they do."
}

cmd_protect() {
  [ $# -eq 1 ] || usage 1
  parse_repo "$1"
  need gh "uses YOUR gh login, not the agent's"
  need jq
  local full="$OWNER/$REPO" coauthor coauthor_email path=.github/workflows/attribution.yml
  coauthor=$(resolve_coauthor)
  coauthor_email=$(printf '%s' "$coauthor" | sed -E 's/^.*<([^>]+)>$/\1/')

  info "Installing $path in $full"
  local content sha
  content=$(sed -e "s|@BOT_EMAIL@|$GH_BOT_EMAIL|" -e "s|@COAUTHOR_EMAIL@|$coauthor_email|" \
              "$ROOT/github/attribution.yml.tmpl" | base64 | tr -d '\n')
  sha=$(gh api "repos/$full/contents/$path" --jq .sha 2>/dev/null || true)
  gh api -X PUT "repos/$full/contents/$path" \
    -f message="ci: agent attribution check" -f content="$content" ${sha:+-f sha="$sha"} >/dev/null \
    || die "could not write $path (does your gh token have the 'workflow' scope? gh auth refresh -s workflow)"

  info "Applying ruleset 'protect-main' to $full"
  local id
  id=$(gh api "repos/$full/rulesets" --jq '.[] | select(.name=="protect-main") | .id' 2>/dev/null || true)
  if [ -n "$id" ]; then
    gh api -X PUT "repos/$full/rulesets/$id" --input "$ROOT/github/ruleset-main.json" >/dev/null
  else
    gh api -X POST "repos/$full/rulesets" --input "$ROOT/github/ruleset-main.json" >/dev/null
  fi

  info "Granting the GitHub App access to $full"
  local repo_id
  repo_id=$(gh api "repos/$full" --jq .id)
  gh api -X PUT "user/installations/$GH_APP_INSTALLATION_ID/repositories/$repo_id" >/dev/null 2>&1 \
    || warn "add it by hand: https://github.com/settings/installations/$GH_APP_INSTALLATION_ID"
}

cmd_rm() {
  [ $# -ge 1 ] || usage 1
  local name=$1 force=${2:-}
  valid_name "$name"
  if [ "$force" != --force ]; then
    local dirty
    dirty=$(sbx exec -e "DEST=$(repo_dir "$name")" "$name" bash -c '
      cd "$DEST" 2>/dev/null || exit 0
      git status --porcelain
      git log --branches --not --remotes --oneline' 2>/dev/null || true)
    [ -z "$dirty" ] || { printf '%s\n' "$dirty" >&2; die "unpushed or uncommitted work in '$name' (use --force)"; }
  fi
  sbx secret rm github --sandbox "$name" >/dev/null 2>&1 || true
  sbx rm "$name"
  [ "$SESSION_MIRROR" != 1 ] || info "Session history kept in ~/.claude/projects/$(claude_slug "$(repo_dir "$name")")"
}

# ---------------------------------------------------------------------------

cmd=${1:-}; shift || true
case "$cmd" in
  setup)   cmd_setup "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  up)      cmd_up "$@" ;;
  code)    cmd_code "$@" ;;
  shell)   cmd_shell "$@" ;;
  claude)  cmd_claude "$@" ;;
  creds)   cmd_creds "$@" ;;
  protect) cmd_protect "$@" ;;
  rm)      cmd_rm "$@" ;;
  ls)      sbx ls ;;
  ""|-h|--help|help) usage 0 ;;
  *) die "unknown command: $cmd (agentbox --help)" ;;
esac
