#!/bin/bash
# gh-agent-token — mint a one-hour GitHub App installation token.
#
# Usage: gh-agent-token <repo> [<repo> ...]      (repo names, no owner)
#
# Prints ONLY the token (sbx reads stdout). The App key streams from
# 1Password through op-agents and never touches disk. The token is limited to
# the given repos and to contents/pull_requests write — no workflows, no admin.
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# shellcheck source=SCRIPTDIR/../config.env
. "$ROOT/config.env"

PERMISSIONS='{"contents":"write","pull_requests":"write","metadata":"read"}'

die() { echo "gh-agent-token: $*" >&2; exit 1; }
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
json_get() { # json_get <key>  (stdin: JSON object)
  if command -v plutil >/dev/null 2>&1; then
    plutil -extract "$1" raw -o - -
  else
    python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"
  fi
}

[ "$#" -ge 1 ] || die "usage: gh-agent-token <repo> [<repo> ...]"

repos=""
for r in "$@"; do
  case "$r" in
    "" | *[!A-Za-z0-9._-]*) die "invalid repo name: '$r'" ;;
  esac
  repos="${repos:+$repos,}\"$r\""
done
body=$(printf '{"repositories":[%s],"permissions":%s}' "$repos" "$PERMISSIONS")

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' \
  "$((now - 60))" "$((now + 540))" "$GH_APP_CLIENT_ID" | b64url)
signature=$(printf '%s.%s' "$header" "$payload" \
  | openssl dgst -sha256 -binary \
      -sign <("$ROOT/bin/op-agents" document get "$GH_APP_KEY_DOC" --vault "$OP_VAULT") \
  | b64url) || die "signing failed (could not read key from 1Password?)"
[ -n "$signature" ] || die "empty signature"
jwt="$header.$payload.$signature"

response=$(curl -sS --fail-with-body -X POST \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  -H @<(printf 'Authorization: Bearer %s\n' "$jwt") \
  --data "$body" \
  "https://api.github.com/app/installations/$GH_APP_INSTALLATION_ID/access_tokens") \
  || die "GitHub API error: $(printf '%s' "${response:-}" | json_get message 2>/dev/null || echo unknown)"

token=$(printf '%s' "$response" | json_get token) || die "no token in GitHub response"
case "$token" in ghs_*) ;; *) die "unexpected token format" ;; esac
printf '%s\n' "$token"
