# agentbox configuration. Sourced by every script in bin/.
# Nothing in here is secret: IDs and names only. Secrets live in 1Password
# (Agents vault) and the macOS Keychain, never in this repo.

# --- Sandbox workload -------------------------------------------------------
# Docker's published v3 Claude Code workload. Bump the tag to update Claude.
WORKLOAD="docker.io/docker/sbx-kit-claude:2.1.267"

# Mixins every sandbox gets (directories under kits/).
DEFAULT_KITS="toolchains agent-config"
# Added with `agentbox up <repo> --cloud`.
CLOUD_KITS="cloud-tools"

# --- 1Password -------------------------------------------------------------
# Keychain item holding the read-only service account token (Agents vault).
OP_KEYCHAIN_SERVICE="op-agents-sa"
OP_VAULT="Agents"

# --- GitHub App (agent identity) -------------------------------------------
GH_APP_CLIENT_ID="Iv23liLCJuKduHURlHS0"
GH_APP_INSTALLATION_ID="174762636"
GH_APP_KEY_DOC="github-app-key"
GH_BOT_NAME="danielgnth[bot]"
GH_BOT_EMAIL="347320681+danielgnth[bot]@users.noreply.github.com"
# Owner used when you pass a bare repo name to `agentbox up`.
GH_DEFAULT_OWNER="danielgnth"

# Human co-author added to every agent commit. Leave empty to derive it from
# your own `gh` login on the Mac (gh api user -> id+login noreply address).
COAUTHOR=""

# --- Optional features -----------------------------------------------------
# Mount the sandbox's Claude session folder into ~/.claude/projects on the Mac
# so Vorssaint (and anything else) sees sandbox sessions. 1 = on, 0 = off.
SESSION_MIRROR=1
# Install git-ai inside sandboxes (AI attribution in git notes). true|false
GIT_AI=true

# --- Short-lived cloud credentials (`agentbox creds <name>`) ---------------
# Read-only GCP service account to impersonate. Empty = skip gcloud.
GCP_AGENT_SA=""
# Kubernetes context, namespace and ServiceAccount (see kube/agent-ro.yaml).
# Empty KUBE_CONTEXT = skip kubectl.
KUBE_CONTEXT=""
KUBE_SA_NAMESPACE="agent-ro"
KUBE_SA_NAME="agent-ro"
