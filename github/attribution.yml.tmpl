# Installed by `agentbox protect`. Agent commits must credit the human
# co-author and must not carry Claude attribution. The agent's token has no
# Workflows permission, so it cannot change this file.
name: attribution

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  attribution:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Agent commits must credit the co-author
        env:
          BOT_EMAIL: "@BOT_EMAIL@"
          COAUTHOR_EMAIL: "@COAUTHOR_EMAIL@"
          BASE: ${{ github.event.pull_request.base.sha || github.event.before }}
          HEAD: ${{ github.event.pull_request.head.sha || github.sha }}
        run: |
          if [ -z "$BASE" ] || echo "$BASE" | grep -qE '^0+$'; then
            commits=$(git rev-list -1 "$HEAD")
          else
            commits=$(git rev-list "$BASE..$HEAD")
          fi
          bad=0
          for c in $commits; do
            [ "$(git log -1 --format=%ae "$c")" = "$BOT_EMAIL" ] || continue
            body=$(git log -1 --format=%B "$c")
            if ! printf '%s\n' "$body" | grep -qiF "co-authored-by:" \
               || ! printf '%s\n' "$body" | grep -qiF "<$COAUTHOR_EMAIL>"; then
              echo "::error::agent commit $c lacks 'Co-authored-by: ... <$COAUTHOR_EMAIL>'"
              bad=1
            fi
            if printf '%s\n' "$body" | grep -qiE '^(co-authored-by:.*(claude|anthropic\.com)|claude-session:)'; then
              echo "::error::agent commit $c still carries Claude attribution"
              bad=1
            fi
          done
          exit $bad
