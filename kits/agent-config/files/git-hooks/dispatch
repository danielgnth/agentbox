#!/bin/sh
# agentbox git hook dispatcher (system-wide core.hooksPath).
#
# Every hook name in this directory is a symlink to this file.
#  1. Runs the repository's own hook first (.git/hooks/<name>), so per-repo
#     hooks keep working even though core.hooksPath points here.
#  2. prepare-commit-msg (which also runs under --no-verify):
#       - refuses commits not authored by the agent bot identity,
#       - strips Claude attribution trailers/footers,
#       - adds the human Co-authored-by trailer exactly once.
#
# Soft layer: a repo-local core.hooksPath (husky, lefthook) or `git -c`
# bypasses it. The `attribution` CI check is the enforcement backstop.
set -eu

name=$(basename "$0")
common_dir=$(git rev-parse --git-common-dir)
repo_hook="$common_dir/hooks/$name"

if [ -x "$repo_hook" ]; then
  "$repo_hook" "$@"
fi

[ "$name" = "prepare-commit-msg" ] || exit 0

msg_file="$1"
coauthor=$(git config --get agentbox.coauthor || true)
bot_email=$(git config --get agentbox.botemail || true)

if [ -n "$bot_email" ]; then
  author=$(git var GIT_AUTHOR_IDENT | sed -E 's/^.*<([^>]*)>.*$/\1/')
  if [ "$author" != "$bot_email" ]; then
    echo "agentbox: commit author is <$author>, expected <$bot_email>." >&2
    echo "agentbox: check 'git config --show-origin --get-all user.email'." >&2
    exit 1
  fi
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
grep -viE '^[[:space:]]*(co-authored-by:.*(claude|anthropic\.com)|claude-session:)|generated with \[?claude code' \
  "$msg_file" > "$tmp" || true
if [ -n "$coauthor" ]; then
  git interpret-trailers --in-place --if-exists addIfDifferent \
    --trailer "Co-authored-by: $coauthor" "$tmp"
fi
cat "$tmp" > "$msg_file"
